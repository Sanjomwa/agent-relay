{
  "title": "Security audit finding",
  "description": "One finding from Semgrep, the model review, or a manual review. `disposition` stays null until a human (Sam) sets it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "severity", "category", "file", "line", "evidence", "source", "confidence", "recommendation", "disposition", "disposition_rationale"],
  "properties": {
    "id": {"type": "string", "pattern": "^(S|M|K)-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 200},
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
    "category": {"type": "string", "minLength": 2, "maxLength": 80},
    "file": {"type": "string", "minLength": 1, "maxLength": 300},
    "line": {"type": ["integer", "null"], "minimum": 1},
    "evidence": {"type": "string", "minLength": 1, "maxLength": 2000},
    "source": {"type": "string", "enum": ["semgrep", "model", "manual"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "recommendation": {"type": "string", "minLength": 1, "maxLength": 1500},
    "disposition": {"type": ["string", "null"], "enum": ["confirmed", "false_positive", "accepted_risk", "fix_now", "fix_later", null]},
    "disposition_rationale": {"type": ["string", "null"], "maxLength": 1000}
  }
}
